#!/usr/bin/env bash
# Install (symlink) the Rambleon AddOn into the WoW: Forever AddOns folder.
# Usage: scripts/install-addon [--copy] [--wow-dir "/Applications/World of Warcraft/_classic_beta_"]
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$REPO/addon/Rambleon"
WOW_DIR="${RAMBLEON_WOW_DIR:-/Applications/World of Warcraft/_classic_beta_}"
MODE="link"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --copy) MODE="copy"; shift ;;
    --wow-dir) WOW_DIR="$2"; shift 2 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

ADDONS="$WOW_DIR/Interface/AddOns"
DEST="$ADDONS/Rambleon"

[[ -f "$SRC/Rambleon.toc" ]] || { echo "AddOn source missing: $SRC" >&2; exit 1; }
[[ -d "$WOW_DIR" ]] || { echo "WoW directory not found: $WOW_DIR" >&2; exit 1; }
mkdir -p "$ADDONS"

if [[ -L "$DEST" ]]; then
  if [[ "$MODE" == "link" && "$(readlink "$DEST")" == "$SRC" ]]; then
    echo "Rambleon already linked: $DEST -> $SRC"
    exit 0
  fi
  rm "$DEST"
elif [[ -d "$DEST" ]]; then
  if [[ "$MODE" == "link" ]]; then
    BACKUP="$DEST.replaced-$(date +%Y%m%d%H%M%S)"
    echo "Existing real directory at $DEST; moving it to $BACKUP"
    mv "$DEST" "$BACKUP"
  fi
fi

if [[ "$MODE" == "link" ]]; then
  ln -s "$SRC" "$DEST"
  echo "Linked $DEST -> $SRC"
else
  mkdir -p "$DEST"
  rsync -a --delete --exclude '.DS_Store' "$SRC/" "$DEST/"
  echo "Copied $SRC -> $DEST"
fi
echo "Now /reload (if WoW is running and the addon was already loaded) or restart WoW."
